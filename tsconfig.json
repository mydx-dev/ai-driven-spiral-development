{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "packages",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "strict": true,
    "types": ["node"]
  },
  "exclude": [
    "dist",
    "packages/cli/**",
    "packages/github/**",
    "packages/quality/**",
    "packages/standard/**",
    "packages/standard-github/**",
    "**/*.spec.ts",
    "**/*.test.ts"
  ],
  "include": ["packages/**/*"]
}
