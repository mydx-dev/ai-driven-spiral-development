{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"]
  },
  "exclude": ["dist", "**/*.spec.ts", "**/*.test.ts"],
  "include": ["src/**/*.ts", "src/**/*.mjs"]
}
