{
  "name": "@mydx-dev/ai-driven-spiral-development",
  "version": "2.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mydx-dev/ai-driven-spiral-development.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier packages/cli/issue-templates.spec.mjs packages/cli/scripts/check-standard-github-issue-templates.mjs packages/standard-github/src/binding.spec.ts --write && git diff --exit-code -- packages/cli/issue-templates.spec.mjs packages/cli/scripts/check-standard-github-issue-templates.mjs packages/standard-github/src/binding.spec.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "build:watch": "rm -rf dist && tsc -p tsconfig.json --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.18.0",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
